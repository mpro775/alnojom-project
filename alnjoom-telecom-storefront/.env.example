# Public canonical storefront URL used for metadata, sitemap, and redirects.
NEXT_PUBLIC_APP_URL=https://alnjoomtelecom.com

# Server-only Alnjoom API origin. Do not prefix this variable with NEXT_PUBLIC_.
BACKEND_API_URL=http://127.0.0.1:3000

# Exact public media origin allowed by next/image (host or full origin).
NEXT_PUBLIC_MEDIA_HOST=media.example.com
